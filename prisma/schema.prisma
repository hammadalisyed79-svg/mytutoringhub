generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id               String    @id @default(cuid())
  name             String
  email            String    @unique
  passwordHash     String?
  role             String    @default("STUDENT")
  phone            String?
  image            String?
  suspended        Boolean   @default(false)
  emailVerified    DateTime?
  onboardingComplete Boolean @default(true)
  stripeCustomerId String?   @unique
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  accounts                 Account[]
  tutorProfile             TutorProfile?
  emailVerificationTokens  EmailVerificationToken[]
  subscriptions            Subscription[]
  studentAds           StudentAd[]
  reviewsGiven         Review[]              @relation("ReviewsGiven")
  conversationsAsA     Conversation[]        @relation("ConversationUserA")
  conversationsAsB     Conversation[]        @relation("ConversationUserB")
  messages             Message[]
  verificationRequests VerificationRequest[]
  reportsFiled         Report[]              @relation("ReportsFiled")
  reviewRequestsSent   ReviewRequest[]       @relation("ReviewRequestsSent")
  reviewRequestsRecv   ReviewRequest[]       @relation("ReviewRequestsRecv")
  aiMessages           AiMessage[]
  adminAuditLogs       AdminAuditLog[]
  pastPaperPurchases   PastPaperPurchase[]
  serviceFeeEvents     ServiceFeeEvent[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Subject {
  id         String      @id @default(cuid())
  name       String      @unique
  slug       String      @unique
  pastPapers PastPaper[]
}

model TutorProfile {
  id              String    @id @default(cuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  headline        String?
  bio             String
  subjects        String
  hourlyRate      Float
  location        String
  online          Boolean   @default(true)
  inPerson        Boolean   @default(false)
  photoUrl        String?
  qualifications  String?
  teachingMethod  String?
  languages       String?
  levels          String?
  availability    String?
  country         String?
  expertise       String?
  experienceYears Int?
  videoUrl        String?
  offersFreeTrial Boolean   @default(false)
  phone           String?
  verified        Boolean   @default(false)
  highlighted     Boolean   @default(false)
  highlightedUntil DateTime?
  boostUntil      DateTime?
  active          Boolean   @default(true)
  forceActive     Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  reviews Review[]
  ads     TutorAd[]
}

model TutorAd {
  id               String       @id @default(cuid())
  tutorProfileId   String
  tutorProfile     TutorProfile @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)
  subject          String
  title            String
  level            String       @default("All levels")
  location         String
  online           Boolean      @default(true)
  inPerson         Boolean      @default(false)
  rate             Float
  description      String?
  status           String       @default("ACTIVE")
  highlightedUntil DateTime?
  boostUntil       DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([status, subject])
  @@index([boostUntil, highlightedUntil])
}

model Subscription {
  id                   String    @id @default(cuid())
  userId               String
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                 String
  status               String    @default("INCOMPLETE")
  stripeSubscriptionId String?   @unique
  stripePriceId        String?
  currentPeriodEnd     DateTime?
  // Extended fields for admin plan management
  role                 String?   // "tutor" | "student"
  billingPeriod        String?   // "monthly" | "annual"
  currency             String?   @default("GBP")
  priceAmount          Float?
  startDate            DateTime? @default(now())
  endDate              DateTime?
  cancelledAt          DateTime?
  notes                String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([userId, plan, status])
}

model ServiceFeeEvent {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventType   String   // "booking_fee" | "profile_boost" | "paper_bundle" | "group_class" | "resource_upload"
  amount      Float
  currency    String   @default("GBP")
  description String?
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
  @@index([eventType, createdAt])
}

model StudentAd {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  subject     String
  level       String
  location    String
  description String
  budget      Float?
  online      Boolean  @default(true)
  inPerson    Boolean  @default(false)
  status      String   @default("OPEN")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, createdAt])
}

model Conversation {
  id            String    @id @default(cuid())
  userAId       String
  userBId       String
  userA         User      @relation("ConversationUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB         User      @relation("ConversationUserB", fields: [userBId], references: [id], onDelete: Cascade)
  relatedAdId   String?
  lastMessageAt DateTime  @default(now())
  createdAt     DateTime  @default(now())
  messages      Message[]

  @@unique([userAId, userBId])
  @@index([lastMessageAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body           String
  attachmentUrl  String?
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

model Review {
  id             String       @id @default(cuid())
  tutorProfileId String
  tutorProfile   TutorProfile @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)
  studentId      String
  student        User         @relation("ReviewsGiven", fields: [studentId], references: [id], onDelete: Cascade)
  rating         Int
  comment        String
  status         String       @default("PUBLISHED")
  createdAt      DateTime     @default(now())

  @@unique([tutorProfileId, studentId])
}

model ReviewRequest {
  id             String   @id @default(cuid())
  tutorUserId    String
  tutorUser      User     @relation("ReviewRequestsSent", fields: [tutorUserId], references: [id], onDelete: Cascade)
  studentId      String
  student        User     @relation("ReviewRequestsRecv", fields: [studentId], references: [id], onDelete: Cascade)
  tutorProfileId String
  status         String   @default("PENDING")
  createdAt      DateTime @default(now())

  @@unique([tutorProfileId, studentId])
}

model VerificationRequest {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  docUrls   String
  notes     String?
  status    String   @default("PENDING")
  adminNote String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
}

model Report {
  id         String   @id @default(cuid())
  reporterId String
  reporter   User     @relation("ReportsFiled", fields: [reporterId], references: [id], onDelete: Cascade)
  targetType String
  targetId   String
  reason     String
  status     String   @default("OPEN")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([status, createdAt])
}

model AiMessage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String
  content   String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model SiteSettings {
  id                   String   @id @default("default")
  maintenanceMode      Boolean  @default(false)
  homepageAnnouncement String   @default("")
  disableSignups       Boolean  @default(false)
  disableAiAssistant   Boolean  @default(false)
  /// Overrides for catalog prices/names: { STUDENT_PASS: { pricePkr, name, description } }
  planPrices           Json     @default("{}")
  /// One-off past paper download fee in PKR base units.
  pastPaperFeePkr      Int      @default(100)
  updatedAt            DateTime @updatedAt
}

model PastPaper {
  id         String   @id @default(cuid())
  catalogKey String   @unique
  subject    String
  board      String
  year       Int
  paperType  String
  title      String
  fileUrl    String?
  /// Public visibility. Kept in sync with isPublic && isActive on write.
  published  Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  purchases  PastPaperPurchase[]
  importItems ImportJobItem[]

  /// Optional Prisma Subject row matched by name — never created during import.
  subjectId        String?
  subjectRef       Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  country          String?
  qualification    String?
  /// curriculum.json `code` (e.g. CIGC-IGCSE-CHEM), not a numeric FK.
  curriculumCode   String?
  /// Official syllabus / subject code when known (e.g. 0620).
  syllabusCode     String?
  session          String?
  paperNumber      String?
  componentCode    String?
  variant          String?
  documentType     String?
  originalFilename String?
  storedFilename   String?
  sourceUrl        String?
  sourceDomain     String?
  storageKey       String?
  fileSize         Int?
  mimeType         String?
  isPublic         Boolean  @default(true)
  isActive         Boolean  @default(true)
  downloadCount    Int      @default(0)
  importStatus     String?
  checksum         String?
  /// BLOB = Vercel Blob (photos and manual PDF uploads). R2 = Cloudflare object key in storageKey.
  storageProvider  String?  @default("BLOB")

  @@index([subject, year])
  @@index([board, year])
  @@index([subject, year, session, documentType])
  @@index([componentCode])
  @@index([checksum])
  @@index([catalogKey])
  @@index([curriculumCode, year, session, documentType, componentCode])
  @@index([syllabusCode, year, session])
  @@index([storageProvider])
  @@index([storageKey])
}

model ImportJob {
  id            String   @id @default(cuid())
  adminId       String?
  source        String
  status        String   @default("PENDING")
  board         String?
  qualification String?
  subject       String?
  subjectCode   String?
  yearFrom      Int?
  yearTo        Int?
  session       String?
  documentType  String?
  totalItems    Int      @default(0)
  newCount      Int      @default(0)
  existsCount   Int      @default(0)
  importedCount Int      @default(0)
  failedCount   Int      @default(0)
  skippedCount  Int      @default(0)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  items         ImportJobItem[]

  @@index([createdAt])
  @@index([status, createdAt])
}

model ImportJobItem {
  id               String     @id @default(cuid())
  jobId            String
  job              ImportJob  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  pastPaperId      String?
  pastPaper        PastPaper? @relation(fields: [pastPaperId], references: [id], onDelete: SetNull)
  originalFilename String
  storedFilename   String?
  sourceUrl        String?
  sourceDomain     String?
  stagingUrl       String?
  stagingKey       String?
  status           String     @default("NEW")
  year             Int?
  session          String?
  subject          String?
  board            String?
  qualification    String?
  country          String?
  curriculumCode   String?
  syllabusCode     String?
  componentCode    String?
  paperNumber      String?
  variant          String?
  documentType     String?
  catalogKey       String?
  checksum         String?
  fileSize         Int?
  mimeType         String?
  error            String?
  selected         Boolean    @default(false)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@index([jobId, status])
  @@index([checksum])
}

model PastPaperPurchase {
  id         String     @id @default(cuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  paperId    String?
  paper      PastPaper? @relation(fields: [paperId], references: [id], onDelete: SetNull)
  catalogKey String
  tracker    String?    @unique
  amountPkr  Float
  status     String     @default("PENDING")
  createdAt  DateTime   @default(now())

  @@index([userId, catalogKey])
}

model AdminAuditLog {
  id         String   @id @default(cuid())
  adminId    String?
  admin      User?    @relation(fields: [adminId], references: [id], onDelete: SetNull)
  action     String
  targetType String
  targetId   String
  detail     String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([adminId, createdAt])
}
