generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id               String    @id @default(cuid())
  name             String
  email            String    @unique
  passwordHash     String?
  role             String    @default("STUDENT")
  phone            String?
  image            String?
  suspended        Boolean   @default(false)
  emailVerified    DateTime?
  onboardingComplete Boolean @default(true)
  // Legacy — replaced by Hub Points referral rewards.
  referralBonusContacts Int @default(0)
  hubPointsBalance Int @default(0)
  hubPointsLastActivityAt DateTime?
  referredByUserId String?
  referredBy User? @relation("UserReferrals", fields: [referredByUserId], references: [id], onDelete: SetNull)
  referrals User[] @relation("UserReferrals")
  hubPointLedger HubPointLedger[]
  stripeCustomerId String?   @unique
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  accounts                 Account[]
  tutorProfile             TutorProfile?
  emailVerificationTokens  EmailVerificationToken[]
  emailSequenceEvents      EmailSequenceEvent[]
  subscriptions            Subscription[]
  studentAds           StudentAd[]
  reviewsGiven         Review[]              @relation("ReviewsGiven")
  conversationsAsA     Conversation[]        @relation("ConversationUserA")
  conversationsAsB     Conversation[]        @relation("ConversationUserB")
  messages             Message[]
  verificationRequests VerificationRequest[]
  reportsFiled         Report[]              @relation("ReportsFiled")
  reviewRequestsSent   ReviewRequest[]       @relation("ReviewRequestsSent")
  reviewRequestsRecv   ReviewRequest[]       @relation("ReviewRequestsRecv")
  aiMessages           AiMessage[]
  adminAuditLogs       AdminAuditLog[]
  pastPaperPurchases   PastPaperPurchase[]
  serviceFeeEvents     ServiceFeeEvent[]
  usageEvents          UsageEvent[]
  studentRequests      StudentRequest[]
  blocksCreated        UserBlock[]           @relation("BlocksCreated")
  blocksReceived       UserBlock[]           @relation("BlocksReceived")
}

/// Peer block: blocker cannot be messaged / contacted by blocked user (and vice versa in contact flows).
model UserBlock {
  id        String   @id @default(cuid())
  blockerId String
  blocker   User     @relation("BlocksCreated", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("BlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)
  reason    String?
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

model HubPointLedger {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount         Int
  balanceAfter   Int
  type           String
  description    String
  relatedUserId  String?
  idempotencyKey String   @unique
  createdAt      DateTime @default(now())

  @@index([userId, createdAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Subject {
  id         String      @id @default(cuid())
  name       String      @unique
  slug       String      @unique
  pastPapers PastPaper[]
}

model TutorProfile {
  id              String    @id @default(cuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  headline        String?
  bio             String
  subjects        String
  hourlyRate      Float
  location        String
  online          Boolean   @default(true)
  inPerson        Boolean   @default(false)
  photoUrl        String?
  qualifications  String?
  teachingMethod  String?
  languages       String?
  levels          String?
  availability    String?
  country         String?
  expertise       String?
  experienceYears Int?
  videoUrl        String?
  introVideoUrl   String?
  offersFreeTrial Boolean   @default(false)
  phone           String?
  photoCropX      Float?    @default(0)
  photoCropY      Float?    @default(0)
  photoCropZoom   Float?    @default(1)
  verified        Boolean   @default(false)
  planTier        Int       @default(0)
  highlighted     Boolean   @default(false)
  highlightedUntil DateTime?
  boostUntil      DateTime?
  active          Boolean   @default(true)
  forceActive     Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  reviews Review[]
  recommendations TutorRecommendation[]
  ads     TutorAd[]
  subjectProfiles SubjectProfile[]
}

model TutorRecommendation {
  id               String       @id @default(cuid())
  tutorProfileId   String
  tutorProfile     TutorProfile @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)
  recommenderName  String
  recommenderEmail String?
  relationship     String?
  comment          String
  proofUrl         String?
  status           String       @default("PENDING")
  adminNote        String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([tutorProfileId, status])
  @@index([status, createdAt])
}

// Teaching Listing (Marketplace V2). Canonical searchable service under one TutorProfile.
// Model name kept as SubjectProfile for migration safety; UX calls these Teaching Listings.
model SubjectProfile {
  id               String       @id @default(cuid())
  tutorProfileId   String
  tutorProfile     TutorProfile @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)
  subject          String
  title            String
  headline         String?
  description      String?
  level            String       @default("All levels")
  /// Curriculum / exam board (e.g. Cambridge International). Optional.
  board            String?
  /// Qualification band when distinct from level (e.g. O Level, GCSE). Optional.
  qualification    String?
  /// Syllabus / subject code (e.g. 5070). Optional; aligns with Past Papers.
  syllabusCode     String?
  location         String
  country          String?
  online           Boolean      @default(true)
  inPerson         Boolean      @default(false)
  rate             Float
  status           String       @default("ACTIVE")
  highlightedUntil DateTime?
  boostUntil       DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([status, subject])
  @@index([boostUntil, highlightedUntil])
  @@index([tutorProfileId, status])
  @@index([board, subject])
  @@index([syllabusCode])
}

// Deprecated: prefer SubjectProfile. Kept for admin history during transition.
model TutorAd {
  id               String       @id @default(cuid())
  tutorProfileId   String
  tutorProfile     TutorProfile @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)
  subject          String
  title            String
  level            String       @default("All levels")
  location         String
  online           Boolean      @default(true)
  inPerson         Boolean      @default(false)
  rate             Float
  description      String?
  status           String       @default("ACTIVE")
  highlightedUntil DateTime?
  boostUntil       DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([status, subject])
  @@index([boostUntil, highlightedUntil])
}

model Subscription {
  id                   String    @id @default(cuid())
  userId               String
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                 String
  status               String    @default("INCOMPLETE")
  stripeSubscriptionId String?   @unique
  stripePriceId        String?
  currentPeriodEnd     DateTime?
  // Extended fields for admin plan management
  role                 String?   // "tutor" | "student"
  billingPeriod        String?   // "monthly" | "annual"
  pointsRedeemedPkr    Int       @default(0)
  currency             String?   @default("GBP")
  priceAmount          Float?
  startDate            DateTime? @default(now())
  endDate              DateTime?
  cancelledAt          DateTime?
  notes                String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([userId, plan, status])
}

model ServiceFeeEvent {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventType   String   // "booking_fee" | "profile_boost" | "paper_bundle" | "group_class" | "resource_upload"
  amount      Float
  currency    String   @default("GBP")
  description String?
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
  @@index([eventType, createdAt])
}

model StudentAd {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        String
  subject      String
  level        String
  /// Optional exam board for Marketplace V2 request matching.
  board        String?
  /// Optional syllabus / subject code (e.g. 5070).
  syllabusCode String?
  location     String
  description  String
  budget       Float?
  online       Boolean  @default(true)
  inPerson     Boolean  @default(false)
  status       String   @default("OPEN")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status, createdAt])
  @@index([subject, status])
}

model Conversation {
  id            String    @id @default(cuid())
  userAId       String
  userBId       String
  userA         User      @relation("ConversationUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB         User      @relation("ConversationUserB", fields: [userBId], references: [id], onDelete: Cascade)
  relatedAdId   String?
  lastMessageAt DateTime  @default(now())
  createdAt     DateTime  @default(now())
  messages      Message[]

  @@unique([userAId, userBId])
  @@index([lastMessageAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body           String
  attachmentUrl  String?
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

model Review {
  id             String       @id @default(cuid())
  tutorProfileId String
  tutorProfile   TutorProfile @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)
  studentId      String
  student        User         @relation("ReviewsGiven", fields: [studentId], references: [id], onDelete: Cascade)
  rating         Int
  comment        String
  /// Student reviews require admin publish; default PENDING matches API.
  status         String       @default("PENDING")
  /// Optional single public response from the tutor (evidence-based reputation).
  tutorResponse  String?
  tutorRespondedAt DateTime?
  createdAt      DateTime     @default(now())

  @@unique([tutorProfileId, studentId])
}

model ReviewRequest {
  id             String   @id @default(cuid())
  tutorUserId    String
  tutorUser      User     @relation("ReviewRequestsSent", fields: [tutorUserId], references: [id], onDelete: Cascade)
  studentId      String
  student        User     @relation("ReviewRequestsRecv", fields: [studentId], references: [id], onDelete: Cascade)
  tutorProfileId String
  status         String   @default("PENDING")
  createdAt      DateTime @default(now())

  @@unique([tutorProfileId, studentId])
}

model VerificationRequest {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  docUrls   String
  notes     String?
  status    String   @default("PENDING")
  adminNote String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
}

model Report {
  id         String   @id @default(cuid())
  reporterId String
  reporter   User     @relation("ReportsFiled", fields: [reporterId], references: [id], onDelete: Cascade)
  targetType String
  targetId   String
  /// Structured category for admin queue (HARASSMENT, SPAM, SCAM, UNDERAGE_SAFETY, OTHER, …).
  category   String   @default("OTHER")
  reason     String
  status     String   @default("OPEN")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([status, createdAt])
  @@index([category, status])
}

model AiMessage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// "study" = study assistant, "support" = platform help chat
  kind      String   @default("study")
  role      String
  content   String
  createdAt DateTime @default(now())

  @@index([userId, kind, createdAt])
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

/// Tracks onboarding / nurture emails so we never double-send.
model EmailSequenceEvent {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sequence String
  sentAt   DateTime @default(now())

  @@unique([userId, sequence])
  @@index([sequence, sentAt])
}

model SiteSettings {
  id                   String   @id @default("default")
  maintenanceMode      Boolean  @default(false)
  homepageAnnouncement String   @default("")
  disableSignups       Boolean  @default(false)
  disableAiAssistant   Boolean  @default(false)
  /// Overrides for catalog prices/names: { STUDENT_PASS: { pricePkr, name, description } }
  planPrices           Json     @default("{}")
  /// One-off past paper download fee in PKR base units.
  pastPaperFeePkr      Int      @default(100)
  updatedAt            DateTime @updatedAt
}

model PastPaper {
  id         String   @id @default(cuid())
  catalogKey String   @unique
  subject    String
  board      String
  year       Int
  paperType  String
  title      String
  fileUrl    String?
  /// Public visibility. Kept in sync with isPublic && isActive on write.
  published  Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  purchases  PastPaperPurchase[]
  importItems ImportJobItem[]

  /// Optional Prisma Subject row matched by name — never created during import.
  subjectId        String?
  subjectRef       Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  country          String?
  qualification    String?
  /// curriculum.json `code` (e.g. CIGC-IGCSE-CHEM), not a numeric FK.
  curriculumCode   String?
  /// Official syllabus / subject code when known (e.g. 0620).
  syllabusCode     String?
  session          String?
  /// Original session string preserved when auto-normalized (quality pass).
  sessionRaw       String?
  paperNumber      String?
  componentCode    String?
  variant          String?
  documentType     String?
  originalFilename String?
  storedFilename   String?
  sourceUrl        String?
  sourceDomain     String?
  storageKey       String?
  fileSize         Int?
  mimeType         String?
  isPublic         Boolean  @default(true)
  isActive         Boolean  @default(true)
  downloadCount    Int      @default(0)
  importStatus     String?
  checksum         String?
  /// BLOB = Vercel Blob (photos and manual PDF uploads). R2 = Cloudflare object key in storageKey.
  storageProvider  String?  @default("BLOB")

  @@index([subject, year])
  @@index([board, year])
  @@index([subject, year, session, documentType])
  @@index([componentCode])
  @@index([checksum])
  @@index([catalogKey])
  @@index([curriculumCode, year, session, documentType, componentCode])
  @@index([syllabusCode, year, session])
  @@index([storageProvider])
  @@index([storageKey])
}

model ImportJob {
  id            String   @id @default(cuid())
  adminId       String?
  source        String
  status        String   @default("PENDING")
  board         String?
  qualification String?
  subject       String?
  subjectCode   String?
  yearFrom      Int?
  yearTo        Int?
  session       String?
  documentType  String?
  totalItems    Int      @default(0)
  newCount      Int      @default(0)
  existsCount   Int      @default(0)
  importedCount Int      @default(0)
  failedCount   Int      @default(0)
  skippedCount  Int      @default(0)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  items         ImportJobItem[]

  @@index([createdAt])
  @@index([status, createdAt])
}

model ImportJobItem {
  id               String     @id @default(cuid())
  jobId            String
  job              ImportJob  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  pastPaperId      String?
  pastPaper        PastPaper? @relation(fields: [pastPaperId], references: [id], onDelete: SetNull)
  originalFilename String
  storedFilename   String?
  sourceUrl        String?
  sourceDomain     String?
  stagingUrl       String?
  stagingKey       String?
  status           String     @default("NEW")
  year             Int?
  session          String?
  subject          String?
  board            String?
  qualification    String?
  country          String?
  curriculumCode   String?
  syllabusCode     String?
  componentCode    String?
  paperNumber      String?
  variant          String?
  documentType     String?
  catalogKey       String?
  checksum         String?
  fileSize         Int?
  mimeType         String?
  error            String?
  selected         Boolean    @default(false)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@index([jobId, status])
  @@index([checksum])
}

model PastPaperPurchase {
  id             String     @id @default(cuid())
  userId         String?
  user           User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  guestEmail     String?
  downloadToken  String?    @unique
  tokenExpiresAt DateTime?
  paperId        String?
  paper          PastPaper? @relation(fields: [paperId], references: [id], onDelete: SetNull)
  catalogKey     String
  tracker        String?    @unique
  amountPkr      Float
  status         String     @default("PENDING")
  createdAt      DateTime   @default(now())

  @@index([userId, catalogKey])
  @@index([guestEmail])
}

model UsageEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String   // "enquiry_reveal" | "tutor_contact" | "paper_download"
  month     String   // "2026-08" format for easy monthly grouping
  createdAt DateTime @default(now())

  @@index([userId, type, month])
}

model ProfileView {
  id        String   @id @default(cuid())
  tutorId   String
  viewedAt  DateTime @default(now())
  country   String?

  @@index([tutorId, viewedAt])
}

/// Durable Marketplace V2 search funnel (volume, zero-results, demand dims, listing impressions).
model SearchAnalyticsEvent {
  id           String   @id @default(cuid())
  type         String
  subject      String?
  board        String?
  location     String?
  country      String?
  level        String?
  resultCount  Int?
  listingIds   String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([type, createdAt])
  @@index([subject, createdAt])
  @@index([board, createdAt])
  @@index([location, createdAt])
}

model StudentRequest {
  id          String   @id @default(cuid())
  studentId   String
  student     User     @relation(fields: [studentId], references: [id])
  subject     String
  level       String
  board       String?
  description String
  schedule    String?
  isPublic    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([subject, isPublic, createdAt])
}

model AdminAuditLog {
  id         String   @id @default(cuid())
  adminId    String?
  admin      User?    @relation(fields: [adminId], references: [id], onDelete: SetNull)
  action     String
  targetType String
  targetId   String
  detail     String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([adminId, createdAt])
}
