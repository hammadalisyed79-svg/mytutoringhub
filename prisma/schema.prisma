generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id               String    @id @default(cuid())
  name             String
  email            String    @unique
  passwordHash     String
  role             String    @default("STUDENT")
  phone            String?
  suspended        Boolean   @default(false)
  emailVerified    DateTime?
  stripeCustomerId String?   @unique
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  tutorProfile             TutorProfile?
  emailVerificationTokens  EmailVerificationToken[]
  subscriptions            Subscription[]
  studentAds           StudentAd[]
  reviewsGiven         Review[]              @relation("ReviewsGiven")
  conversationsAsA     Conversation[]        @relation("ConversationUserA")
  conversationsAsB     Conversation[]        @relation("ConversationUserB")
  messages             Message[]
  verificationRequests VerificationRequest[]
  reportsFiled         Report[]              @relation("ReportsFiled")
  reviewRequestsSent   ReviewRequest[]       @relation("ReviewRequestsSent")
  reviewRequestsRecv   ReviewRequest[]       @relation("ReviewRequestsRecv")
  aiMessages           AiMessage[]
  adminAuditLogs       AdminAuditLog[]
}

model Subject {
  id   String @id @default(cuid())
  name String @unique
  slug String @unique
}

model TutorProfile {
  id              String    @id @default(cuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  headline        String?
  bio             String
  subjects        String
  hourlyRate      Float
  location        String
  online          Boolean   @default(true)
  inPerson        Boolean   @default(false)
  photoUrl        String?
  qualifications  String?
  teachingMethod  String?
  languages       String?
  levels          String?
  availability    String?
  videoUrl        String?
  offersFreeTrial Boolean   @default(false)
  phone           String?
  verified        Boolean   @default(false)
  highlighted     Boolean   @default(false)
  highlightedUntil DateTime?
  boostUntil      DateTime?
  active          Boolean   @default(true)
  forceActive     Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  reviews Review[]
  ads     TutorAd[]
}

model TutorAd {
  id               String       @id @default(cuid())
  tutorProfileId   String
  tutorProfile     TutorProfile @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)
  subject          String
  title            String
  level            String       @default("All levels")
  location         String
  online           Boolean      @default(true)
  inPerson         Boolean      @default(false)
  rate             Float
  description      String?
  status           String       @default("ACTIVE")
  highlightedUntil DateTime?
  boostUntil       DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([status, subject])
  @@index([boostUntil, highlightedUntil])
}

model Subscription {
  id                   String    @id @default(cuid())
  userId               String
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                 String
  status               String    @default("INCOMPLETE")
  stripeSubscriptionId String?   @unique
  stripePriceId        String?
  currentPeriodEnd     DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([userId, plan, status])
}

model StudentAd {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  subject     String
  level       String
  location    String
  description String
  budget      Float?
  online      Boolean  @default(true)
  inPerson    Boolean  @default(false)
  status      String   @default("OPEN")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, createdAt])
}

model Conversation {
  id            String    @id @default(cuid())
  userAId       String
  userBId       String
  userA         User      @relation("ConversationUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB         User      @relation("ConversationUserB", fields: [userBId], references: [id], onDelete: Cascade)
  relatedAdId   String?
  lastMessageAt DateTime  @default(now())
  createdAt     DateTime  @default(now())
  messages      Message[]

  @@unique([userAId, userBId])
  @@index([lastMessageAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body           String
  attachmentUrl  String?
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

model Review {
  id             String       @id @default(cuid())
  tutorProfileId String
  tutorProfile   TutorProfile @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)
  studentId      String
  student        User         @relation("ReviewsGiven", fields: [studentId], references: [id], onDelete: Cascade)
  rating         Int
  comment        String
  status         String       @default("PUBLISHED")
  createdAt      DateTime     @default(now())

  @@unique([tutorProfileId, studentId])
}

model ReviewRequest {
  id             String   @id @default(cuid())
  tutorUserId    String
  tutorUser      User     @relation("ReviewRequestsSent", fields: [tutorUserId], references: [id], onDelete: Cascade)
  studentId      String
  student        User     @relation("ReviewRequestsRecv", fields: [studentId], references: [id], onDelete: Cascade)
  tutorProfileId String
  status         String   @default("PENDING")
  createdAt      DateTime @default(now())

  @@unique([tutorProfileId, studentId])
}

model VerificationRequest {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  docUrls   String
  notes     String?
  status    String   @default("PENDING")
  adminNote String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
}

model Report {
  id         String   @id @default(cuid())
  reporterId String
  reporter   User     @relation("ReportsFiled", fields: [reporterId], references: [id], onDelete: Cascade)
  targetType String
  targetId   String
  reason     String
  status     String   @default("OPEN")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([status, createdAt])
}

model AiMessage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String
  content   String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model SiteSettings {
  id                   String   @id @default("default")
  maintenanceMode      Boolean  @default(false)
  homepageAnnouncement String   @default("")
  disableSignups       Boolean  @default(false)
  disableAiAssistant   Boolean  @default(false)
  /// Overrides for catalog prices/names: { STUDENT_PASS: { pricePkr, name, description } }
  planPrices           Json     @default("{}")
  updatedAt            DateTime @updatedAt
}

model AdminAuditLog {
  id         String   @id @default(cuid())
  adminId    String?
  admin      User?    @relation(fields: [adminId], references: [id], onDelete: SetNull)
  action     String
  targetType String
  targetId   String
  detail     String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([adminId, createdAt])
}
