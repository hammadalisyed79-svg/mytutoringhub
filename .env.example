# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
AUTH_SECRET="generate-a-long-random-string"
AUTH_TRUST_HOST="true"

# Google sign-in (OAuth 2.0 — Google Cloud Console → APIs & Services → Credentials)
# Authorized redirect URI: https://www.mytutoringhub.com/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Database (Postgres — use Vercel Neon connection string in production)
DATABASE_URL="postgresql://user:pass@host:5432/mytutoringhub?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:pass@host:5432/mytutoringhub?sslmode=require"

# Safepay (sandbox: https://sandbox.api.getsafepay.com/dashboard/developers/api)
# Public key = SAFEPAY_API_KEY (starts with sec_…)
# Secret key = SAFEPAY_SECRET_KEY (long hex — never commit)
SAFEPAY_API_KEY="sec_..."
SAFEPAY_SECRET_KEY="replace_with_sandbox_secret"
# sandbox | production (or live). Sandbox forces PKR for 3DS dummy cards.
# Production uses the visitor/preferred currency via checkoutCurrency — do not force PKR.
# Put live API keys on Vercel (Production env). Never commit live secrets.
SAFEPAY_ENV="sandbox"
# CYBERSOURCE or MPGS
SAFEPAY_INTENT="CYBERSOURCE"

# Stripe (optional fallback if Safepay is not configured)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_PRICE_STUDENT_PASS="price_..."
STRIPE_PRICE_TUTOR_BASIC="price_..."
STRIPE_PRICE_VERIFIED_TUTOR="price_..."
STRIPE_PRICE_HIGHLIGHTED_AD="price_..."
STRIPE_PRICE_AD_BOOST="price_..."
STRIPE_PRICE_UNLIMITED_ADS="price_..."

# Resend (required for signup, sign-in confirmations, and receipts)
# Domain mytutoringhub.com must be verified in Resend. All mail is sent from admin@mytutoringhub.com.
RESEND_API_KEY=""
EMAIL_FROM="My Tutoring Hub <admin@mytutoringhub.com>"

# Vercel Blob (profile photos + verification docs + manual past-paper uploads)
BLOB_READ_WRITE_TOKEN=""

# Cloudflare R2 (Cambridge past papers — server-only, never NEXT_PUBLIC_)
# Prefer a private bucket. Signed GET URLs are issued after auth/payment.
# R2_ACCOUNT_ID="your-cloudflare-account-id"
# Or set the S3 API endpoint directly:
# R2_ENDPOINT="https://<accountid>.r2.cloudflarestorage.com"
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET="past-papers"
# Optional. Omit for a private bucket (preferred).
# R2_PUBLIC_BASE_URL=""
# Optional object-key prefix for Chemistry 0620 sync (default cambridge/igcse/chemistry/0620/)
# R2_PREFIX="cambridge/igcse/chemistry/0620/"
# The standalone importer's S3_ENDPOINT_URL / S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY / S3_BUCKET names are also accepted.

# Optional: comma-separated hosts allowed for admin HTTPS PDF URL import.
# If empty, any HTTPS URL is allowed except blocked third-party paper libraries.
# PAST_PAPER_ALLOWED_DOMAINS="cdn.example.com,files.mytutoringhub.com"

# OpenAI Study Assistant
OPENAI_API_KEY=""

# Weekly student-ad digests for tutors (Vercel Cron → GET /api/digests/ads)
# Set CRON_SECRET in Vercel; cron sends Authorization: Bearer <CRON_SECRET>
CRON_SECRET=""
DIGEST_SECRET=""
