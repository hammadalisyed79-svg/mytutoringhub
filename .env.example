# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
AUTH_SECRET="generate-a-long-random-string"
AUTH_TRUST_HOST="true"

# Database (Postgres — use Vercel Neon connection string in production)
DATABASE_URL="postgresql://user:pass@host:5432/mytutoringhub?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:pass@host:5432/mytutoringhub?sslmode=require"

# Safepay (sandbox: https://sandbox.api.getsafepay.com/dashboard/developers/api)
# Public key = SAFEPAY_API_KEY (starts with sec_…)
# Secret key = SAFEPAY_SECRET_KEY (long hex — never commit)
SAFEPAY_API_KEY="sec_..."
SAFEPAY_SECRET_KEY="replace_with_sandbox_secret"
SAFEPAY_ENV="sandbox"
# CYBERSOURCE or MPGS
SAFEPAY_INTENT="CYBERSOURCE"

# Stripe (optional fallback if Safepay is not configured)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_PRICE_STUDENT_PASS="price_..."
STRIPE_PRICE_TUTOR_BASIC="price_..."
STRIPE_PRICE_VERIFIED_TUTOR="price_..."
STRIPE_PRICE_HIGHLIGHTED_AD="price_..."
STRIPE_PRICE_AD_BOOST="price_..."
STRIPE_PRICE_UNLIMITED_ADS="price_..."

# Resend
RESEND_API_KEY=""
EMAIL_FROM="MyTutoringHub <noreply@mytutoringhub.com>"

# Optional: weekly student-ad digests for tutors (GET /api/digests/ads)
CRON_SECRET=""
DIGEST_SECRET=""
